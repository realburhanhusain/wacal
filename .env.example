# Copy to .env and fill in. Never commit the real file.

# --- Transport -----------------------------------------------------------
# cloud | twilio | memory. Unset picks whichever provider has full credentials,
# preferring Meta Cloud API, and falls back to the in-memory transport.
WA_TRANSPORT=

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Any string you choose; paste the same value into the Meta webhook form.
WA_VERIFY_TOKEN=change-me

# Meta app secret, used to verify X-Hub-Signature-256. REQUIRED: with this
# empty the /webhook routes answer 403, because an unverifiable webhook is an
# unauthenticated command channel. Set WACAL_ALLOW_UNSIGNED=1 for local runs.
WA_APP_SECRET=

# From the Meta app dashboard, WhatsApp > API Setup.
# With both unset, replies go to an in-memory transport instead of WhatsApp.
WA_PHONE_NUMBER_ID=
WA_TOKEN=

WA_GRAPH_VERSION=v21.0

# --- WhatsApp (Twilio) ---------------------------------------------------
# Twilio has no interactive list message, so replies become numbered text and
# the user answers with a number. TWILIO_AUTH_TOKEN also verifies
# X-Twilio-Signature; empty disables that check, which is local-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public origin, e.g. https://book.example.com. Twilio signs the exact URL it
# was configured with, so behind a TLS-terminating proxy the internal
# http://... URL never matches. Only the scheme and host are taken from here;
# the path comes from the request.
TWILIO_PUBLIC_URL=

# --- Server --------------------------------------------------------------
# Public base URL. Used for the OAuth redirect URI and for booking links.
BASE_URL=http://localhost:8000

# Guards /dashboard/*. Unset means those routes return 503, not open access.
ADMIN_KEY=

# Defaults to ~/.wacal/wacal.db
WACAL_DB=

# --- Google Calendar (optional, per user) --------------------------------
# OAuth 2.0 Web application client JSON from the Google Cloud console.
# Authorised redirect URI must be exactly: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_SECRETS_FILE=./client_secrets.json

# Signs the 15-minute state token in the OAuth link. Falls back to
# WA_APP_SECRET. There is no built-in default: a published key would let anyone
# mint a state for any user and attach their own Google account to it.
WACAL_STATE_SECRET=

# Local development only. Allows unsigned webhooks and an unsigned OAuth state.
# Never set this on a deployment that a real phone number can reach.
WACAL_ALLOW_UNSIGNED=
