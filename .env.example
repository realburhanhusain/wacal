# Copy to .env and fill in. Never commit the real file.

# --- Transport -----------------------------------------------------------
# cloud | twilio | memory. Unset picks whichever provider has full credentials,
# preferring Meta Cloud API, and falls back to the in-memory transport.
WA_TRANSPORT=

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Any string you choose; paste the same value into the Meta webhook form.
WA_VERIFY_TOKEN=change-me

# Meta app secret, used to verify X-Hub-Signature-256. REQUIRED: with this
# empty the /webhook routes answer 403, because an unverifiable webhook is an
# unauthenticated command channel. Set WACAL_ALLOW_UNSIGNED=1 for local runs.
WA_APP_SECRET=

# From the Meta app dashboard, WhatsApp > API Setup.
# With both unset, replies go to an in-memory transport instead of WhatsApp.
WA_PHONE_NUMBER_ID=
WA_TOKEN=

WA_GRAPH_VERSION=v21.0

# --- WhatsApp (Twilio) ---------------------------------------------------
# Twilio has no interactive list message, so replies become numbered text and
# the user answers with a number. TWILIO_AUTH_TOKEN also verifies
# X-Twilio-Signature; empty disables that check, which is local-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public origin, e.g. https://book.example.com. Twilio signs the exact URL it
# was configured with, so behind a TLS-terminating proxy the internal
# http://... URL never matches. Only the scheme and host are taken from here;
# the path comes from the request.
TWILIO_PUBLIC_URL=

# --- Server --------------------------------------------------------------
# Public base URL. Used for the OAuth redirect URI and for booking links.
BASE_URL=http://localhost:8000

# Guards /dashboard/*. Unset means those routes return 503, not open access.
ADMIN_KEY=

# Defaults to ~/.wacal/wacal.db
WACAL_DB=

# --- Google Calendar (optional, per user) --------------------------------
# OAuth 2.0 Web application client JSON from the Google Cloud console.
# Authorised redirect URI must be exactly: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_SECRETS_FILE=./client_secrets.json

# Signs the 15-minute state token in the OAuth link. Falls back to
# WA_APP_SECRET. There is no built-in default: a published key would let anyone
# mint a state for any user and attach their own Google account to it.
WACAL_STATE_SECRET=

# Local development only. Allows unsigned webhooks and an unsigned OAuth state.
# Never set this on a deployment that a real phone number can reach.
WACAL_ALLOW_UNSIGNED=

# --- Secrets at rest -----------------------------------------------------
# Encrypts the Google refresh tokens in calendar_links. A refresh token is a
# standing grant over someone's calendar, so without this the database file is
# the whole secret. Generate one with: python -m wacal.crypto
# Losing this key means affected users must send "connect google" again.
WACAL_TOKEN_KEY=

# Local development only: store calendar tokens unencrypted.
WACAL_ALLOW_PLAINTEXT_TOKENS=

# --- Template messages ---------------------------------------------------
# WhatsApp delivers a free-form message only within 24 hours of the
# recipient's last inbound one. Outside that, these approved templates are the
# only thing that arrives -- and the notifications that matter (a new booking,
# a cancellation, a verification code) are exactly the ones sent outside it.
# Create them in WhatsApp Manager > Message templates; see the README for the
# variable order. On Twilio these hold a Content template SID (HX...) instead.
# Left empty, such a message is refused and held in the outbox rather than
# sent into the void; it goes out when that person next messages the number.
WA_TEMPLATE_BOOKING_CONFIRMED=
WA_TEMPLATE_BOOKING_CANCELLED=
WA_TEMPLATE_BOOKING_REMINDER=
WA_TEMPLATE_OTP=

# Must match the language the template was approved in, e.g. en or en_US.
WA_TEMPLATE_LANGUAGE=en

# Local development only: send free-form text outside the 24-hour window. On a
# real number this turns a visible refusal into a message nobody receives.
WACAL_ALLOW_FREEFORM_OUTSIDE_WINDOW=

# --- One-time codes ------------------------------------------------------
# Require POST /dashboard/register's owner_phone to prove itself with a code
# first. An inbound message already proves its sender; a typed number does
# not, and that number then receives other people's bookings.
WACAL_REQUIRE_OTP=

# Keys the stored digest of a code. Falls back to WACAL_TOKEN_KEY.
WACAL_OTP_PEPPER=

# --- Rate limiting -------------------------------------------------------
# Per sender, two sliding windows: a burst and a sustained one. Generous by
# design -- a customer tapping through a booking sends several messages in a
# few seconds. Set both counts to 0 to disable.
WACAL_RATE_BURST=20
WACAL_RATE_BURST_SECONDS=20
WACAL_RATE_SUSTAINED=120
WACAL_RATE_SUSTAINED_SECONDS=600

# How often to retry anything still sitting in the outbox. Replies go out
# immediately; this is only for a send that failed while nobody was texting.
WACAL_DRAIN_SECONDS=60

# --- Process model -------------------------------------------------------
# wacal serialises bookings with an in-process lock, so it takes an exclusive
# lock on <database>.writer.lock at startup and a second process refuses to
# start. Set this to 1 only once writes are guarded across processes, e.g. by a
# Postgres range exclusion constraint.
WACAL_ALLOW_MULTIPROCESS=
